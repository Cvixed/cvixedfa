# Single Owner Access via Google Authenticator (TOTP)
# Generate a Base32 key (mis. JBSWY3DPEHPK3PXP) atau scan QR via halaman /auth/totp
APP_TOTP_SECRET=JBSWY3DPEHPK3PXP
APP_SESSION_SECRET=cvixedfa-single-owner-secure-session-key-2026

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (SERVER ONLY - never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI (SERVER ONLY - never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
